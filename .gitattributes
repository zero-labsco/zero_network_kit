# Normalize every text file to LF on both commit and checkout so the
# "CRLF will be replaced by LF" warning never appears again.
* text=auto eol=lf

# Be explicit about the most common source extensions.
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.podspec text eol=lf
*.toml text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.map text eol=lf
